@page
@model KissakiSignup.Web.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Admin-Anmeldung";
}

<h1>Admin-Anmeldung</h1>

<form method="post">
    <input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Passwort</label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" type="password" />
    </div>
    <button type="submit" class="btn btn-primary">Anmelden</button>
</form>
